{
  "expo": {
    "name": "问事",
    "slug": "wenshi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xuezhihengg.wenshi",
      "infoPlist": {
        "NSCameraUsageDescription": "问事需要访问相机，用于拍摄并设置个人头像。",
        "NSPhotoLibraryUsageDescription": "问事需要访问相册，用于选择并设置个人头像。",
        "NSPhotoLibraryAddUsageDescription": "问事需要保存图片到相册。",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.xuezhihengg.wenshi",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/wenshi_icon.png",
        "backgroundColor": "#f5f3ec"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "问事需要访问相册，用于选择并设置个人头像。",
          "cameraPermission": "问事需要访问相机，用于拍摄并设置个人头像。"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.replace-me"
        }
      ]
    ]
  }
}
