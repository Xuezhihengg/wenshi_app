{
  "expo": {
    "name": "wenshi-app",
    "slug": "wenshi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.wenshi-app",
      "infoPlist": {
        "NSCameraUsageDescription": "问事需要访问相机，用于拍摄并设置个人头像。",
        "NSPhotoLibraryUsageDescription": "问事需要访问相册，用于选择并设置个人头像。",
        "NSPhotoLibraryAddUsageDescription": "问事需要保存图片到相册。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "问事需要访问相册，用于选择并设置个人头像。",
          "cameraPermission": "问事需要访问相机，用于拍摄并设置个人头像。"
        }
      ],
      [
        "./plugins/withCustomMetroPort",
        {
          "port": 8083,
          "host": "172.20.10.12"
        }
      ]
    ]
  }
}
