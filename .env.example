# Backend API base URL.
# - iOS simulator / web: http://127.0.0.1:8000
# - Android emulator:    http://10.0.2.2:8000
# - Physical device:     http://<your-computer-lan-ip>:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Development-only auto login with the mock verification code.
# Enabled by default in development; set to 0 to disable.
EXPO_PUBLIC_ENABLE_DEV_LOGIN=1

# Google Sign-In. Create your own OAuth clients in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.replace-me

# Optional overrides for forks. Keep the official app IDs when shipping the
# existing app, or set your own identifiers before publishing a fork.
# APP_BUNDLE_ID=com.example.wenshi
# APP_PACKAGE=com.example.wenshi
